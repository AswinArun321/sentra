# SENTRA — Environment Configuration Template
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ============================================================
# CORE DJANGO SETTINGS
# ============================================================

# Required: Strong random secret key for cryptographic signing.
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Development: any value works. Production: MUST be a strong random key.
SECRET_KEY=

# Set to True only for local development. Always False in production.
DEBUG=True

# Comma-separated list of allowed hostnames.
# Development: localhost,127.0.0.1
# Production:  your-app.onrender.com  (or your custom domain)
ALLOWED_HOSTS=localhost,127.0.0.1

# Required in production: Your HTTPS origin(s) for CSRF protection.
# Production: https://your-app.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ============================================================
# DATABASE
# ============================================================

# Leave empty to use SQLite for local development.
# Production: set to your PostgreSQL connection URL from Render.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ============================================================
# GITHUB OAUTH INTEGRATION
# ============================================================

# Create a GitHub OAuth App at: https://github.com/settings/developers
# Development callback:  http://127.0.0.1:8000/github/callback/
# Production callback:   https://your-app.onrender.com/github/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/github/callback/

# ============================================================
# EXTERNAL VULNERABILITY APIS
# ============================================================

# OSV.dev vulnerability API — no authentication required
OSV_API_URL=https://api.osv.dev/v1/query

# Optional: NVD API key for enhanced vulnerability data
NVD_API_KEY=

# ============================================================
# CORS (optional — override defaults for API-only deployments)
# ============================================================

# Comma-separated list of trusted frontend origins for CORS.
# Leave empty to use the built-in defaults (localhost ports).
CORS_ALLOWED_ORIGINS=
